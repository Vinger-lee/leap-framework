  {
    "name": "foldout explains last-second boundary and supports closing",
    "steps": [
      {
        "action": "click",
        "selector": "#fall-intervals summary"
      },
      {
        "action": "evaluate",
        "script": "window.__fallFold=document.querySelector('#fall-intervals details').open"
      },
