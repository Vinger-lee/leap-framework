[
  {
    "name": "wrong understanding-check answer records an attempt",
    "steps": [
      {
        "action": "click",
        "selector": ".opt[data-v=\"bad\"] >> nth=0"
      }
    ],
    "assertions": [
      "window.LEAP.getInteractionResult().events.some(e => e.event_type === 'attempt_submitted')"
    ]
  },
  {
    "name": "hint ladder cannot skip to full answer",
    "steps": [],
    "assertions": [
      "window.LEAP.getInteractionResult().ui_state.answer_revealed === false",
      "window.LEAP.getInteractionResult().ui_state.completed === false",
      "document.querySelector('.ladder-step[data-lv=\"4\"]').disabled === true"
    ]
  },
  {
    "name": "queue preview does not discard pending calls",
    "steps": [
      {
        "action": "click",
        "selector": ".opt[data-v=\"ok\"] >> nth=0"
      },
      {
        "action": "evaluate",
        "script": "window.__pending = window.LEAP.peekOutbox().length"
      },
      {
        "action": "click",
        "selector": "#bridgeDrain"
      }
    ],
    "assertions": [
      "window.__pending > 0 && window.LEAP.peekOutbox().length === window.__pending"
    ]
  },
  {
    "name": "demo assessment never promotes Runtime state",
    "steps": [
      {
        "action": "evaluate",
        "script": "window.__stage = window.LEAP.getInteractionResult().assessment.evidence_stage; window.LEAP.pushEvent('attempt_submitted',{item_id:'test',answer:'test answer',hint_level:0}); window.LEAP.commitAssessment({item_id:'test',correctness:1,conceptual_understanding:1,reasoning_quality:1,application:1,transfer:1})"
      }
    ],
    "assertions": [
      "window.LEAP.getInteractionResult().assessment.evidence_stage === window.__stage",
      "window.LEAP.getInteractionResult().assessment.provisional === true"
    ]
  },
  {
    "name": "local completion requests guard check",
    "steps": [
      {
        "action": "evaluate",
        "script": "window.LEAP.setCompleted('test','activity finished')"
      }
    ],
    "assertions": [
      "window.LEAP.peekOutbox().some(c => c.tool === 'check_advance_unit')",
      "!window.LEAP.peekOutbox().some(c => c.tool === 'advance_unit')"
    ]
  },
  {
    "name": "branch task empty submission",
    "steps": [
      {
        "action": "click",
        "selector": "#btnSubmitQ1"
      }
    ],
    "assertions": [
      "window.LEAP.getInteractionResult().assessment.correctness < 0.8",
      "window.LEAP.getInteractionResult().ui_state.completed === false"
    ]
  },
  {
    "name": "loop initialization changes variables and highlights exact node",
    "steps": [
      {
        "action": "click",
        "selector": "#loopNext"
      }
    ],
    "assertions": [
      "document.querySelector('#loopSvg').dataset.node === 'init'",
      "document.querySelector('#loopSvg').dataset.i === '1' && document.querySelector('#loopSvg').dataset.sum === '0'",
      "document.querySelector('#loopSvg [data-loop-node=\"init\"]').dataset.active === 'true'",
      "document.querySelector('#loopSvg [data-loop-edge=\"start-init\"]').dataset.active === 'true'"
    ]
  },
  {
    "name": "loop three sums to six and executes final false decision",
    "steps": [
      {
        "action": "evaluate",
        "script": "while(!document.getElementById('loopNext').disabled)document.getElementById('loopNext').click();"
      }
    ],
    "assertions": [
      "document.querySelector('#loopSvg').dataset.node === 'end'",
      "document.querySelector('#loopSvg').dataset.output === '6'",
      "document.querySelector('#loopSvg').dataset.i === '4'",
      "Array.from(document.querySelectorAll('#loopHistory tr')).filter(r=>r.cells[0].textContent==='判断').length === 4",
      "document.querySelector('#loopHistory').textContent.includes('假，准备输出')"
    ]
  },
  {
    "name": "zero loop never enters body and returns empty sum",
    "steps": [
      {
        "action": "fill",
        "selector": "#loopN",
        "value": "0"
      },
      {
        "action": "evaluate",
        "script": "while(!document.getElementById('loopNext').disabled)document.getElementById('loopNext').click();"
      }
    ],
    "assertions": [
      "document.querySelector('#loopSvg').dataset.output === '0'",
      "document.querySelector('#loopSvg').dataset.i === '1'",
      "document.querySelectorAll('#loopHistory tr').length === 1",
      "!document.querySelector('#loopHistory').textContent.includes('累加')"
    ]
  },
  {
    "name": "loop back edge becomes highlighted on repeated condition",
    "steps": [
      {
        "action": "evaluate",
        "script": "for(let k=0;k<5;k++)document.getElementById('loopNext').click();"
      }
    ],
    "assertions": [
      "document.querySelector('#loopSvg').dataset.node === 'test'",
      "document.querySelector('#loopSvg [data-loop-edge=\"update-test\"]').dataset.active === 'true'",
      "document.querySelector('#loopSvg').dataset.i === '2'"
    ]
  },
  {
    "name": "missing update pauses without claiming algorithm has output",
    "steps": [
      {
        "action": "evaluate",
        "script": "const x=document.getElementById('loopMode');x.value='missing';x.dispatchEvent(new Event('change',{bubbles:true}));while(!document.getElementById('loopNext').disabled)document.getElementById('loopNext').click();"
      }
    ],
    "assertions": [
      "document.querySelector('#loopSvg').dataset.node === 'paused'",
      "document.querySelector('#loopSvg').dataset.i === '1'",
      "document.querySelector('#loopSvg').dataset.output === ''",
      "document.querySelector('#loopStatus').textContent.includes('不是算法结束')",
      "window.LEAP.getInteractionResult().events.some(e=>e.item_id==='flow-loop-trace'&&e.answer.includes('paused')&&e.error_type==='reasoning_error')"
    ]
  },
  {
    "name": "loop previous and reset restore original state",
    "steps": [
      {
        "action": "click",
        "selector": "#loopNext"
      },
      {
        "action": "click",
        "selector": "#loopNext"
      },
      {
        "action": "click",
        "selector": "#loopPrev"
      },
      {
        "action": "click",
        "selector": "#loopReset"
      }
    ],
    "assertions": [
      "document.querySelector('#loopSvg').dataset.node === 'start'",
      "document.querySelector('#loopSvg').dataset.i === ''",
      "document.querySelectorAll('#loopHistory tr').length === 0",
      "document.querySelector('#loopPrev').disabled === true"
    ]
  },
  {
    "name": "zero parity wrong and correct answers classify attempts",
    "steps": [
      {
        "action": "click",
        "selector": "input[name=\"flowZero\"][value=\"odd\"]"
      },
      {
        "action": "click",
        "selector": "#flowZeroCheck"
      },
      {
        "action": "evaluate",
        "script": "window.__wrongZero=document.getElementById('flowZeroFeedback').dataset.result"
      },
      {
        "action": "click",
        "selector": "input[name=\"flowZero\"][value=\"even\"]"
      },
      {
        "action": "click",
        "selector": "#flowZeroCheck"
      }
    ],
    "assertions": [
      "window.__wrongZero === 'incorrect'",
      "document.querySelector('#flowZeroFeedback').dataset.result === 'correct'",
      "window.LEAP.getInteractionResult().events.filter(e=>e.item_id==='flow-zero').length===2"
    ]
  },
  {
    "name": "loop prediction catches forgotten final condition",
    "steps": [
      {
        "action": "fill",
        "selector": "#loopAnswerS",
        "value": "6"
      },
      {
        "action": "fill",
        "selector": "#loopAnswerI",
        "value": "3"
      },
      {
        "action": "fill",
        "selector": "#loopAnswerChecks",
        "value": "3"
      },
      {
        "action": "click",
        "selector": "#loopAnswerCheck"
      },
      {
        "action": "evaluate",
        "script": "window.__wrongLoop=document.getElementById('loopAnswerFeedback').dataset.result"
      },
      {
        "action": "fill",
        "selector": "#loopAnswerI",
        "value": "4"
      },
      {
        "action": "fill",
        "selector": "#loopAnswerChecks",
        "value": "4"
      },
      {
        "action": "click",
        "selector": "#loopAnswerCheck"
      }
    ],
    "assertions": [
      "window.__wrongLoop === 'incorrect'",
      "document.querySelector('#loopAnswerFeedback').dataset.result === 'correct'",
      "document.querySelector('#loopAnswerFeedback').textContent.includes('第4次判断')"
    ]
  },
  {
    "name": "product transfer distinguishes multiplication identity from empty sum",
    "steps": [
      {
        "action": "fill",
        "selector": "#flowProductBase",
        "value": "0"
      },
      {
        "action": "fill",
        "selector": "#flowProductZero",
        "value": "0"
      },
      {
        "action": "click",
        "selector": "#flowProductCheck"
      },
      {
        "action": "evaluate",
        "script": "window.__wrongProduct=document.getElementById('flowProductFeedback').dataset.result"
      },
      {
        "action": "fill",
        "selector": "#flowProductBase",
        "value": "1"
      },
      {
        "action": "fill",
        "selector": "#flowProductZero",
        "value": "1"
      },
      {
        "action": "click",
        "selector": "#flowProductCheck"
      }
    ],
    "assertions": [
      "window.__wrongProduct === 'incorrect'",
      "document.querySelector('#flowProductFeedback').dataset.result === 'correct'",
      "window.LEAP.getInteractionResult().events.filter(e=>e.item_id==='flow-product-transfer')[1].error_type==='none'"
    ]
  },
  {
