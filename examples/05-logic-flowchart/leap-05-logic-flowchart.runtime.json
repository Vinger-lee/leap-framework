  {
    "name": "free explanation is submitted for host semantic review without keyword grade or completion",
    "steps": [
      {
        "action": "evaluate",
        "script": "document.getElementById('verify').hidden=false;window.__beforeExplanation=window.LEAP.getInteractionResult().assessment.correctness;window.__guardCount=window.LEAP.peekOutbox().filter(c=>c.tool==='check_advance_unit').length;"
      },
