      "document.querySelector('#exeStep').textContent.includes('真，选')",
      "document.querySelector('#realOut').textContent === '—'",
      "document.querySelector('#exeNodes .is-cur').dataset.id==='d'",
      "!window.LEAP.getInteractionResult().events.some(e=>e.item_id==='q2'&&e.event_type==='code_run')"
