      "window.LEAP.getInteractionResult().assessment.correctness===1",
      "window.LEAP.getInteractionResult().assessment.correctness===1 && window.LEAP.getInteractionResult().assessment.transfer===null",
      "window.LEAP.peekOutbox().filter(c=>c.tool==='commit_assessment').pop().args.raw_answer==='1/2 | 2'"
    ]
  },
  {
    "name": "zero gravity boundary rejects zero-time then accepts static",
    "steps": [
      {
        "action": "evaluate",
        "script": "document.querySelector('#fallBoundary').value='zero'"
      },
      {
        "action": "click",
        "selector": "#fallBoundaryCheck"
      },
      {
        "action": "evaluate",
        "script": "window.__wrongZero=window.LEAP.getInteractionResult().assessment.correctness"
      },
      {
        "action": "evaluate",
        "script": "document.querySelector('#fallBoundary').value='still'"
      },
      {
        "action": "click",
        "selector": "#fallBoundaryCheck"
      }
    ],
    "assertions": [
      "window.__wrongZero===0",
      "window.LEAP.getInteractionResult().assessment.correctness===1",
      "document.querySelector('#fallBoundaryFeedback').textContent.includes('不能除以0')"
    ]
  },
