  {
    "name": "checkpoint retries keep both original attempts",
    "steps": [
      {
        "action": "click",
        "selector": ".opt[data-v=\"bad\"] >> nth=0"
      },
      {
        "action": "click",
        "selector": ".opt[data-v=\"ok\"] >> nth=0"
      }
    ],
    "assertions": [
      "window.LEAP.getInteractionResult().events.filter(e=>e.item_id==='cp-01'&&e.event_type==='attempt_submitted').length===2",
      "window.LEAP.peekOutbox().filter(c=>c.tool==='submit_attempt'&&c.args.item_id==='cp-01').length===2"
    ]
